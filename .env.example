# Local MongoDB and authentication
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/quorix
MONGODB_DB=quorix
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Question provider: ollama for local development, gemini for production
LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2

# Production Gemini
# Get a key from Google AI Studio and keep it server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_MS=1000
GEMINI_TIMEOUT_MS=120000

# Provider-neutral generation settings
PYTHON_PIPELINE_TIMEOUT_MS=180000
DUPLICATE_THRESHOLD=0.86
